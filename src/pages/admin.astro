---
const basePath = Astro.base ?? '/';
const adminBase = `${basePath.replace(/\/$/, '')}/admin/`;
const configPath = `${basePath.replace(/\/$/, '')}/config.yml`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Dashboard</title>
    <base href={adminBase} />
    <script src="https://unpkg.com/decap-cms@^3.8.0/dist/decap-cms.js"></script>
  </head>
  <body>
    <script>
      window.CMS_MANUAL_INIT = true;
      window.addEventListener('DOMContentLoaded', () => {
        // Use explicit deployed config path for GitHub Pages project sites
        window.CMS.init({ config: '/Portfolio/config.yml' });
      });
    </script>
  </body>
</html>
